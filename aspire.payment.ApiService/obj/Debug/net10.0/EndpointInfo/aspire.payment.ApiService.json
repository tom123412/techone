{
  "openapi": "3.1.1",
  "info": {
    "title": "aspire.payment.ApiService | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:63523"
    },
    {
      "url": "http://localhost:63524"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "aspire.payment.ApiService"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/weatherforecast": {
      "get": {
        "tags": [
          "aspire.payment.ApiService"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/payments": {
      "post": {
        "tags": [
          "aspire.payment.ApiService"
        ],
        "operationId": "CreatePayment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePaymentRequest": {
        "required": [
          "invoiceDate",
          "ledgerCode",
          "accountNumber",
          "gstExclusiveAmount",
          "gstAmount",
          "gstInclusiveAmount",
          "invoiceNarration1",
          "invoiceNarration2",
          "invoiceNarration3",
          "bid",
          "purchaseLocation",
          "purchaseOrderNumber",
          "generalLedgerCode",
          "registeredForGST",
          "applicationID",
          "requestedBy"
        ],
        "type": "object",
        "properties": {
          "invoiceDate": {
            "type": "string",
            "format": "date"
          },
          "ledgerCode": {
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "gstExclusiveAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "gstAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "gstInclusiveAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "invoiceNarration1": {
            "type": "string"
          },
          "invoiceNarration2": {
            "type": "string"
          },
          "invoiceNarration3": {
            "type": "string"
          },
          "bid": {
            "type": "string"
          },
          "purchaseLocation": {
            "type": "string"
          },
          "purchaseOrderNumber": {
            "type": "string"
          },
          "generalLedgerCode": {
            "type": "string"
          },
          "registeredForGST": {
            "type": "boolean"
          },
          "applicationID": {
            "type": "string"
          },
          "requestedBy": {
            "type": "string"
          }
        }
      },
      "WeatherForecast": {
        "required": [
          "date",
          "temperatureC",
          "summary"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "aspire.payment.ApiService"
    }
  ]
}